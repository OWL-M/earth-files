earth-files = Earth Files

opening-files = Opening…
into-itself = A folder cannot be moved or copied into itself
task-paused = இடைநிறுத்தப்பட்டது
task-paused-waiting = இடைநிறுத்தப்பட்டது, காத்திருக்கிறது
blocked-read = "{$name}" ஐப் படிக்க முடியவில்லை
blocked-list = "{$name}" கோப்புறையைத் திறக்க முடியவில்லை
blocked-remove = "{$name}" நகலெடுக்கப்பட்டது, ஆனால் அகற்ற முடியவில்லை
same-for-rest = மீதமுள்ளவற்றுக்கும் இதையே செய்
retry = மீண்டும் முயல்
retry-as-root = நிர்வாகியாக மீண்டும் முயல்
use-root-again = நிர்வாகி உரிமைகளை மீண்டும் பயன்படுத்து
root-not-granted = நிர்வாகி அணுகல் வழங்கப்படவில்லை
abort = நிறுத்து
blocked-failed = "{$name}" ஐ முடிக்க முடியவில்லை
abort-tooltip = இங்கே நிறுத்தி, முடிந்ததை வைத்திரு
cancel-tooltip = நிறுத்தி எல்லாவற்றையும் முன்பிருந்தபடி மீட்டமை
stalled-title = இயக்ககம் பதிலளிக்கவில்லை
stalled-for = {$seconds} வி. ஆக பதில் இல்லை
keep-original = அசலை வைத்திரு
destination-no-permission = "{$folder}" இல் எழுத முடியவில்லை: அனுமதி இல்லை
destination-read-only = "{$folder}" இல் எழுத முடியவில்லை: இது படிக்க மட்டுமே
blocked-link = "{$name}" ஒரு இணைப்பு, இந்த இயக்ககத்தால் இணைப்புகளை வைத்திருக்க முடியாது
blocked-link-fs = "{$name}" ஒரு இணைப்பு, இந்த இயக்ககத்தால் ({$fs}) இணைப்புகளை வைத்திருக்க முடியாது
blocked-too-big = "{$name}" இந்த இயக்ககத்துக்கு ({$fs}) மிகப் பெரியது
blocked-bad-name = இந்த இயக்ககத்தால் ({$fs}) வைத்திருக்க முடியாத எழுத்துகள் "{$name}" இல் உள்ளன
progress-asking = இடைநிறுத்தப்பட்டது
failed-path = "{$name}": {$reason}
reason-no-permission = அனுமதி இல்லை
reason-drive-full = இயக்ககம் நிரம்பியுள்ளது
reason-read-only = இயக்ககம் படிக்க மட்டுமே
reason-gone = அது இனி இல்லை
reason-too-big = இந்த இயக்ககத்திற்கு அது மிகப் பெரியது
blocked-move = "{$name}" ஐ நகர்த்த முடியவில்லை
blocked-move-reason = "{$folder}" இலிருந்து மூலங்களை அகற்ற முடியவில்லை: {$reason}
same-for-rest-count = மீதமுள்ளவற்றுக்கும் இதையே செய் ({$count})
not-enough-space = இதற்கு {$needed} தேவை, ஆனால் {$free} மட்டுமே காலியாக உள்ளது
checking = சரிபார்க்கிறது… கோப்புகள்: {$files}, {$size}
rollback-failed = {$more ->
    [0] ரத்துசெய்யப்பட்டது, ஆனால் "{$name}" ஐ மீண்டும் வைக்க முடியவில்லை
    *[other] ரத்துசெய்யப்பட்டது, ஆனால் "{$name}" மற்றும் மேலும் {$more} ஐ மீண்டும் வைக்க முடியவில்லை
  }
failed-operations-title = {$count ->
    [one] செயல்பாடு தோல்வியடைந்தது
    *[other] {$count} செயல்பாடுகள் தோல்வியடைந்தன
  }
merge = ஒன்றிணை
replace-folder-warning = அவற்றை ஒன்றிணைக்க விரும்புகிறீர்களா, அல்லது அங்குள்ள கோப்புறையை மாற்றியமைக்க விரும்புகிறீர்களா? மாற்றியமைத்தால் அது குப்பைக்கு அனுப்பப்படும்.
folder-totals = { $files ->
    [one] { $files } கோப்பு, { $size }
   *[other] { $files } கோப்புகள், { $size }
}
